{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A/B test verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ab_test_id",
    "verdict",
    "reason",
    "leader",
    "p2bb_expected",
    "p2bb_raw",
    "maturity",
    "horizon_days",
    "come_back_on",
    "arms",
    "calibration_source",
    "expected_gap_per_user",
    "money",
    "next_action",
    "next_action_basis"
  ],
  "properties": {
    "ab_test_id": {"type": "string"},
    "verdict": {"enum": ["not_enough_data", "confirmed", "tie", "keep_running"]},
    "reason": {
      "type": ["string", "null"],
      "enum": ["min_events", "no_calibration", "pending_revenue", "underpowered", null]
    },
    "leader": {"type": "string"},
    "p2bb_expected": {"type": "number", "minimum": 0, "maximum": 1},
    "p2bb_raw": {"type": "number", "minimum": 0, "maximum": 1},
    "maturity": {"type": "number"},
    "horizon_days": {"type": "integer", "minimum": 1},
    "come_back_on": {"type": ["string", "null"], "format": "date"},
    "arms": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "users", "revenue_received", "revenue_expected_trials", "revenue_expected_renewals",
                     "revenue_expected_total"],
        "properties": {
          "title": {"type": "string"},
          "users": {"type": "integer", "minimum": 0},
          "revenue_received": {"type": "number"},
          "revenue_expected_trials": {"type": "number"},
          "revenue_expected_renewals": {"type": "number"},
          "revenue_expected_total": {"type": "number"}
        }
      }
    },
    "calibration_source": {"enum": ["product", "app", "none"]},
    "expected_gap_per_user": {"type": "number", "minimum": 0},
    "money": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["traffic_per_day", "after_days", "cost_per_day", "loss_if_ship_leader_now", "cost_until_come_back",
                   "chance_leader_is_wrong"],
      "properties": {
        "traffic_per_day": {"type": "number", "minimum": 0},
        "after_days": {"type": "integer", "minimum": 1},
        "cost_per_day": {"type": "number", "minimum": 0},
        "loss_if_ship_leader_now": {"type": "number", "minimum": 0},
        "cost_until_come_back": {"type": ["number", "null"], "minimum": 0},
        "chance_leader_is_wrong": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "next_action": {"enum": ["ship_leader", "ship_either", "come_back"]},
    "next_action_basis": {"enum": ["verdict", "money", "horizon"]}
  },
  "allOf": [
    {
      "if": {"properties": {"verdict": {"enum": ["confirmed", "tie"]}}},
      "then": {"properties": {"reason": {"type": "null"}, "come_back_on": {"type": "null"}}}
    },
    {
      "if": {"properties": {"verdict": {"enum": ["not_enough_data"]}}},
      "then": {"properties": {"reason": {"enum": ["min_events", "no_calibration"]}}}
    },
    {
      "if": {"properties": {"reason": {"enum": ["no_calibration"]}}},
      "then": {"properties": {"come_back_on": {"type": "null"}}}
    },
    {
      "if": {"properties": {"verdict": {"enum": ["keep_running"]}}},
      "then": {"properties": {"reason": {"enum": ["pending_revenue", "underpowered"]}, "come_back_on": {"type": "string"}}}
    },
    {
      "if": {"properties": {"verdict": {"enum": ["not_enough_data"]}}},
      "then": {"properties": {"money": {"type": "null"}, "next_action": {"enum": ["come_back"]},
                              "next_action_basis": {"enum": ["verdict"]}}}
    },
    {
      "if": {"properties": {"verdict": {"enum": ["confirmed", "tie"]}}},
      "then": {"properties": {"money": {"properties": {"cost_until_come_back": {"type": "null"}}},
                              "next_action_basis": {"enum": ["verdict"]}}}
    },
    {
      "if": {"properties": {"verdict": {"enum": ["keep_running"]}}},
      "then": {"properties": {"money": {"properties": {"cost_until_come_back": {"type": "number"}}},
                              "next_action": {"enum": ["ship_leader", "ship_either", "come_back"]}}}
    },
    {
      "if": {"properties": {"verdict": {"enum": ["confirmed", "tie", "keep_running"]}}},
      "then": {"properties": {"money": {"type": "object"}}}
    }
  ]
}
